# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Name (switch models without modifying source code)
# Supported models include:
#   gemini-3.8-flash (default, high capability & speed)
#   gemini-3.6-flash (fallback option)
#   gemini-2.5-flash
#   gemini-2.0-flash
#   gemini-1.5-flash
#   gemini-1.5-pro
GEMINI_MODEL=gemini-3.8-flash

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Application Environment (development, production)
ENVIRONMENT=production

# Agent37 Mythos Automated Research Configuration (optional)
# AGENT37_API_KEY=your_agent37_api_key_here
# AGENT37_INSTANCE_ID=your_instance_id_here
# AGENT37_INSTANCE_URL=https://your_instance_id.agent37.app
# AGENT37_RESEARCH_TIMEOUT=90

# Gemini Concurrency & Quota Management (optional)
# Conservative defaults prevent bursting quotas on free-tier models (e.g. 5 RPM on gemini-3.6-flash)
# MAX_CONCURRENT_CALLS=2
# JUDGE_CONCURRENCY=1
# GEMINI_MAX_RETRIES=3
# GEMINI_INITIAL_RETRY_DELAY=2.0
# GEMINI_MAX_RETRY_DELAY=30.0
# JUDGE_RATE_LIMIT_DELAY=0.0

# Overall Gemini request timeout (10-300 seconds; default: 180).
# SDK network timeout is 5 seconds shorter so its worker can exit before the async guard.
# GEMINI_TIMEOUT_SECONDS=180

# Authentication Configuration
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_to_a_random_64_char_secret_key_before_deploying

# Database path (default: backend/data/ideavalidator.db)
# DATABASE_PATH=data/ideavalidator.db
